# Upstash Redis (REST) credentials for the shared leaderboard.
# Copy to .env.local and paste your real values:
#   cp .env.example .env.local
#
# Vercel's Upstash integration injects these automatically in preview and
# production, so this file is only needed for `vercel dev`.
#
# Without them, /api/scores fails and the leaderboard degrades to a
# local-only board that shows "offline" — questions and scoring still work.

KV_REST_API_URL=
KV_REST_API_TOKEN=
