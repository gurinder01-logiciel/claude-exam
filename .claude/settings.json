{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-snapshot.mjs"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-bank.mjs"
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "upstash": {
      "source": {
        "source": "github",
        "repo": "upstash/skills"
      }
    }
  },
  "enabledPlugins": {
    "upstash@upstash": true
  }
}
